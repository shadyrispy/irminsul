<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- VPN permission, foreground-service permissions and the capture service
         itself all arrive from the capture AAR via manifest merging.
         POST_NOTIFICATIONS does not: this activity asks for it at runtime, and a
         request for an undeclared permission is denied without ever showing a
         dialog. The library declares nothing a host has to opt out of. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="Irminsul Sample" android:allowBackup="false">
        <activity
            android:name=".SampleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
